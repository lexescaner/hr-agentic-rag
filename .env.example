# Copy this file to .env and fill in real values. Never commit .env itself.

# LLM provider (OpenRouter free-tier or your own key)
OPENROUTER_API_KEY=

# Embedding model provider (if using a hosted free-tier embedding API instead of local)
EMBEDDING_API_KEY=

# Optional: override default model names
LLM_MODEL=
EMBEDDING_MODEL=

# MCP server connection (if running MCP servers as separate services later)
MCP_POLICY_SERVER_URL=
MCP_HR_DATA_SERVER_URL=
